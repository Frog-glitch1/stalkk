name: build
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.5
      - run: gradle build
      - run: python3 tools/make_mrpack.py
      - uses: actions/upload-artifact@v4
        with:
          name: the-stalker
          path: |
            build/libs/the-stalker-*.jar
            *.mrpack
